# Spendid — copy to .env (make up does this for you on first run)

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:8600
# Testing on a phone on the same Wi-Fi: add this computer's address (make phone-url prints it).
EXTRA_ORIGINS=
# Header holding the visitor's IP (per-IP sign-in limits). Behind Cloudflare: cf-connecting-ip
CLIENT_IP_HEADER=x-forwarded-for
API_PORT=8601

# Postgres 18 + pgvector (container spendid-db, host port 8602)
POSTGRES_USER=spendid
POSTGRES_PASSWORD=spendid
POSTGRES_DB=spendid
DATABASE_URL=postgres://spendid:spendid@db:5432/spendid

# Redis 8 (container spendid-redis, host port 8603)
REDIS_URL=redis://redis:6379

# Web dev server proxies /api to this address inside the Docker network
VITE_API_PROXY=http://api:8601

# Better Auth — sessions and tokens are signed with this. Production refuses the placeholder.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Seeded admin (manages the app and accounts; never sees spending). Production refuses admin/admin.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@spendid.local

# Outgoing email. In dev every message lands in Mailpit (http://localhost:8604).
SMTP_HOST=mail
SMTP_PORT=1025
# Production: your provider's login (port 587 STARTTLS or 465 TLS). Leave empty for Mailpit.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Spendid <hello@spendid.local>

# ILMU (OpenAI-compatible). Text, vision and speech all come from here.
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_API_KEY=your-ilmu-key
ILMU_TEXT_MODEL=ilmu-v3.1
ILMU_VISION_MODEL=ilmu-vision-v1.3
# Shop-name matching (merchant clean-up). Only names are sent, never amounts.
ILMU_EMBED_MODEL=bge-m3
ILMU_ASR_MODEL=ilmu-asr-v4.2
# Default AI allowance per person per month (admin can change per person in M6).
AI_MONTHLY_TOKENS_DEFAULT=200000

# Receipt photos are stored encrypted (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
RECEIPTS_DIR=/data/receipts
RECEIPT_ENCRYPTION_KEY=

# Production only (docker-compose.prod.yml): your domain, e.g. spendid.example.com.
# Caddy gets HTTPS certificates for it automatically. Camera and passkeys need HTTPS.
SITE_ADDRESS=:80
