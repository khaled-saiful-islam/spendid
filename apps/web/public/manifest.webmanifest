{
	"name": "Spendid",
	"short_name": "Spendid",
	"description": "Know what you can safely spend today.",
	"start_url": "/app",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#f6f3fc",
	"theme_color": "#2a1446",
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "receipt",
					"accept": [
						"image/*",
						"application/pdf",
						".pdf"
					]
				}
			]
		}
	}
}
