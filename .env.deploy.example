# Settings for `make deploy`. Copy to .env.deploy (git-ignored; it stays on this computer).
DEPLOY_HOST=ubuntu@your-server-ip
DEPLOY_KEY=~/.ssh/your-server-key
DEPLOY_DIR=/opt/spendid
# The server's chip: linux/amd64 for most cloud servers, linux/arm64 for ARM ones.
DEPLOY_PLATFORM=linux/amd64
# Add docker-compose.tunnel.yml when the server already serves ports 80/443.
DEPLOY_COMPOSE="docker-compose.prod.yml docker-compose.tunnel.yml"
