# SITE_ADDRESS is your domain (Caddy gets HTTPS certificates automatically) or ":80".
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	# API, including live updates (server-sent events must not be buffered).
	handle /api/* {
		reverse_proxy api:8601 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@immutable path /assets/* /vad/* /cv/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /manifest.webmanifest /index.html
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
