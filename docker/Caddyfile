# SITE_ADDRESS is your domain (Caddy gets HTTPS certificates automatically) or ":80".

{
	servers {
		# Behind a proxy on the private Docker network (a Cloudflare Tunnel, say), keep the
		# visitor's own address in X-Forwarded-For instead of the proxy's.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		# Never shown inside another site's frame (clickjacking).
		X-Frame-Options DENY
		# Scripts only from Spendid itself, no inline scripts. WebAssembly is allowed for the
		# voice model; styles allow inline for animation; images and media allow blob: previews.
		# "?" = only when not set already (the scanner worker sets its own below).
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API, including live updates (server-sent events must not be buffered).
	handle /api/* {
		reverse_proxy api:8601 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@immutable path /assets/* /vad/* /cv/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# The scanner worker's own policy: OpenCV.js needs eval, only inside that worker.
		@scanner path /cv/*
		header @scanner Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'"
		@fresh path /sw.js /manifest.webmanifest /index.html /theme.js
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
